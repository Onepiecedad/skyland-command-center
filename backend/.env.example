# Server Configuration
NODE_ENV=development
PORT=3001

# Logging
LOG_LEVEL=info

# Supabase (Optional - for realtime features)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database (if not using Supabase)
# DATABASE_URL=postgresql://user:password@localhost:5432/skyland

# --- Databasreaktivering (SCC-46) ---
# shadow = logga vad som skulle skickats (messages.status='shadow'), skicka inget. auto = styrs av OUTBOUND_ENABLED.
OUTBOUND_MODE=auto

# --- Sajt-webhookar skylandai.se (SCC-48, ersätter n8n) ---
# Fly-proxyn (skyland-voice-proxy) postar avslutade röstsamtal till
# /api/v1/webhooks/site/voice-call-ended?token=<SITE_VOICE_WEBHOOK_TOKEN>. Fallback: LEADS_INTAKE_TOKEN.
# SITE_VOICE_WEBHOOK_TOKEN=
# Server-till-server-nyckel för /api/v1/webhooks/site/rag-query (X-Skyland-Key). Fallback: LEADS_INTAKE_TOKEN.
# SITE_RAG_KEY=
# Extra CORS-origins, kommaseparerade (skylandai.se, www och skyland-ai-os.netlify.app är alltid med).
# EXTRA_CORS_ORIGINS=
